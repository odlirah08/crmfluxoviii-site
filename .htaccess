# ===== FLUXO VIII — site de vendas =====
RewriteEngine On

# Sempre HTTPS e sem "www"
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://crmfluxoviii.tech%{REQUEST_URI} [L,R=301]

# crmfluxoviii.tech/login (ou /entrar) → tela de login do CRM
# Quando o CRM ganhar o endereço app.crmfluxoviii.tech, troque só o endereço abaixo.
RewriteRule ^(login|entrar)/?$ https://app.crmfluxoviii.tech/entrar [L,R=302]

# Páginas sem ".html" no endereço
RewriteRule ^planos/?$ planos.html [L]
RewriteRule ^ficha/?$ ficha.html [L]
RewriteRule ^parceiros/?$ parceiros.html [L]

# Arquivos internos não ficam acessíveis
RewriteRule ^(README\.md|\.git.*)$ - [F,L]

# Segurança
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://fluxo-vii-crm--gen-lang-client-0285512077.us-east4.hosted.app https://app.crmfluxoviii.tech; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
</IfModule>
Options -Indexes

# Cache: imagens por 30 dias; páginas, estilos e script sempre na versão nova
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType text/javascript "access plus 0 seconds"
</IfModule>
